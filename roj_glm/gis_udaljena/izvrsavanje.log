n the Territory of Serbia, Gallery of SANU, Beograd 2018 (tekst na srpskom i engleskom), odlomak o Medijani\",\n    \"fajl\": \"pdf/pop-lazic_limes_2018.pdf\",\n    \"tekst\": \"pdf/pop_lazic.txt (862.918 znakova, 392 strane)\",\n    \"url\": \"https://rai.ai.ac.rs/bitstream/id/2194/ROMAN_LIMES_AND_CITIES_ON_THE_TERRITORY.pdf\",\n    \"poverenje\": \"visoko (recenzirana publikacija Arheoloskog instituta, otvoreni pristup)\"\n  },\n  \"novi_citativni_dokazi\": [\n    {\n      \"id\": \"castellum-dva-bazena\",\n      \"tvrdnja\": \"Vodotoranj (castellum aquae) je rezervoar sa DVA bazena: za talozenje, filtriranje i distribuciju vode\",\n      \"period\": \"kraj III veka\",\n      \"lokacija\": \"na padini Vlaskog brda\",\n      \"poverenje\": \"visoko\",\n      \"implikacija_3d\": \"castellum nije jedan zdenac nego dvocleni hidraulicki objekat — modelovati dva bazena u kaskadi (talozenje pa distribucija)\"\n    },\n    {\n      \"id\": \"dva-kanala\",\n      \"tvrdnja\": \"Iz kule vodotornja na severnom delu objekta voda se sprovodi GLAVNIM kanalom i JEDNIM REVIZIONIM (rezervnim) kanalom prema naselju\",\n      \"poverenje\": \"visoko\",\n      \"implikacija_3d\": \"DVE paralelne linije trase u modelu: primarna + rezervna; oboje polaze sa severne strane castelluma\"\n    },\n    {\n      \"id\": \"villa-oktagon-2000m2\",\n      \"tvrdnja\": \"Vila sa oktogonom: istrazena povrsina oko 2000 m2; zapadni deo kompleksa oblikovan kao oktagon; prostorni parkovi i vrtovi povezani tremovima\",\n      \"poverenje\": \"visoko\",\n      \"konflikt\": \"stara procena 6.000–6.800 m2 se odnosila na vilu sa peristilom, NE na vilu sa oktogonom — konflikt povrsine iz v0.2 se ovim resava: dve razlicite gradjevine\"\n    },\n    {\n      \"id\": \"barake-4ha\",\n      \"tvrdnja\": \"Vojne barake i radionice oruzja i alata istocno i zapadno od vile sa peristilom; zapadni kompleks oko 4 ha; barake sa drvenim tremovima, mermerne oplata i freske i unutar baraka\",\n      \"poverenje\": \"visoko\",\n      \"implikacija_3d\": \"novo: dva kompleksa baraka kao 3D stubovi niskog ranga dekoracije ali visokog kvaliteta gradnje\"\n    },\n    {\n      \"id\": \"crkve-50m-istok\",\n      \"tvrdnja\": \"Dve ranohriscanske crkve ~50 m istocno od istoecnog zida vile sa peristilom; istok-zapad orijentacija; od spolija i drveta; jednobrodne sa apsidom na istoku; u juznoj (starijoj) mozaik Hristograma na ambonu\",\n      \"period\": \"kraj IV – pocetak V veka\",\n      \"poverenje\": \"visoko\",\n      \"implikacija_3d\": \"nova dva 3D stuba sa orijentacijom i relativnom pozicijom (50 m od zida)\"\n    },\n    {\n      \"id\": \"broncana-ograda-324\",\n      \"tvrdnja\": \"B ronzana ograda (cancelli) sa plocama i hermama; ukupno 4 herme sa bistovima (Asclepius, Hygieia, Sol, Luna — Hygieia i Sol nadeni nisu); najverovatnije oko 324; stajala na ulazu apside sale za gozbe\",\n      \"poverenje\": \"visoko\",\n      \"implikacija_3d\": \"fiksna pozicija i datum za dekorativni element — vezuje se na vilu sa konhama (sala za gozbe)\"\n    },\n    {\n      \"id\": \"porfirne-skulpture-1972\",\n      \"tvrdnja\": \"Nalaz 1972: porfirne skulpture Asclepiusa sa Telesforom, Hygieie, Afrodite Sosandre, Herkula, Merkura, Dionisa i Dionisove triade (Menada, Satir)\",\n      \"poverenje\": \"visoko\",\n      \"napomena\": \"dopunjuje postojeci zapis o skulpturama 1972 iz wiki-sr — sada imenovane figure\"\n    },\n    {\n      \"id\": \"dea-dardanica\",\n      \"tvrdnja\": \"Medijana lezila pored javnog puta; posetioci na ulazu u administrativno-rezidencijalni kompleks docekivani statuom Dea Dardanica, zastitnice Dardanaca\",\n      \"poverenje\": \"srednje (interpretacija autora rada)\",\n      \"implikacija_3d\": \"programming ulazne tačke sa strane javnog puta\"\n    },\n    {\n      \"id\": \"vicennalia\",\n      \"tvrdnja\": \"Obimni i brzi radovi na rekonstrukciji i podizanje monumentalnih gradjevina u vezi sa pripremama proslave trideset godina vladavine Konstantina (Vicennalia)\",\n      \"poverenje\": \"visoko\",\n      \"implikacija\": \"datira glavnu fazu dekoracije na ~325/326 (vicennalia = 20 godina? autor pise 'trideset' — napomena: Vicennalia je 325/326 (20+), Tricennalia 335/336; tekst kaze 'trideset' sto odgovara Tricennaliji — konflikt za proveru)\"\n    },\n    \"olovna cev kroz osnovu zida 59 (sektor 5) — voda uvadjena u zid, ne preko: argument za skrivene vodove u zidovima vile (3D: cevi ne idu po podovima)\",\n    \"kada 1,6 x 1,5 m u e-12 na garezi nad slojem D — vodeni program horizonta 3 i posle rusenja 378\"\n  ],\n  \"vodena_mreza\": {\n    \"cvorovi\": [\n      {\n        \"id\": \"izvor-hipoteza-oblik\",\n        \"tip\": \"hipoteza\",\n        \"opis\": \"vodozahvat na Obliku (wiki-sr)\",\n        \"poverenje\": \"nisko\",\n        \"status\": \"nepotvrdjeno — Pop-Lazic ne navodi izvor\"\n      },\n      {\n        \"id\": \"izvor-hipoteza-niska-banja\",\n        \"tip\": \"hipoteza\",\n        \"opis\": \"vodozahvat pravcem Niske Banje (drugi izvori)\",\n        \"poverenje\": \"nisko\",\n        \"status\": \"nepotvrdjeno\"\n      },\n      {\n        \"id\": \"castellum-aquae\",\n        \"tip\": \"cvor-distribucije\",\n        \"period\": \"kraj III veka\",\n        \"lokacija\": \"padina Vlaskog brda, ~500 m JZ od vile (Prostorni sloj + repozitorijum AI zrvnji rad)\",\n        \"struktura\": \"kula sa dva bazena (talozenje + distribucija/filtriranje)\",\n        \"izlazi\": [\n          \"kanal-glavni\",\n          \"kanal-revizioni\"\n        ],\n        \"visina_mnv\": {\n          \"procena\": 206,\n          \"opseg\": [\n            204,\n            210\n          ],\n          \"izvor\": \"DEM procena iz prostorni_sloj v0.3\",\n          \"poverenje\": \"srednje\"\n        },\n        \"poverenje_struktura\": \"visoko (Pop-Lazic 2018)\"\n      },\n      {\n        \"id\": \"kanal-glavni\",\n        \"tip\": \"linija\",\n        \"od\": \"castellum-aquae (severna strana)\",\n        \"ka\": \"naselje/vila sa peristilom\",\n        \"geometrija\": \"gravitaciona; pad ~8-10 m na ~500 m\",\n        \"poverenje\": \"visoko (postojanje), nisko (tacna trasa)\"\n      },\n      {\n        \"id\": \"kanal-revizioni\",\n        \"tip\": \"linija\",\n        \"od\": \"castellum-aquae (severna strana)\",\n        \"ka\": \"naselje\",\n        \"uloga\": \"rezervni/pomoćni kanal\",\n        \"poverenje\": \"visoko (postojanje), nisko (tacna trasa)\"\n      },\n      {\n        \"id\": \"fontana-nimfej\",\n        \"tip\": \"krajnji-cvor\",\n        \"veza\": \"prostorni_sloj.objekti_3d_stubi.fontana-nimfej; vizuelna potvrda olovne cevi u dnu bazena (v0.6, kadrovi VI-VII)\",\n        \"poverenje\": \"visoko (postojanje i oblik), nisko (visina)\"\n      },\n      {\n        \"id\": \"horreum-cella-vinaria\",\n        \"tip\": \"krajnji-cvor-tehnoloski\",\n        \"opis\": \"zapadni deo horreuma kasnije pregradjen pręgradnim zidovima u bazene za cedjenje i proizvodnju vina (cella vinaria); dubina bazena 1,40 m (v0.1)\",\n        \"poverenje\": \"visoko\"\n      },\n      {\n        \"id\": \"olovna-cev-prostorija-12\",\n        \"tip\": \"linija-fizicki-dokaz\",\n        \"opis\": \"olovna vodovodna cev u prostoriji 12: sonda 107 kota 198.49, nastavlja se kroz sondu 80; u sonda 80 luk ~5 m pravac SZ-JI i PROLAZI KROZ OSNOVU zida 59 (postavljena pri gradnji zida), osnova 198.40\",\n        \"izvor\": \"Starinar 64/2014, sektor 5 (5.1.1 i 5.2.1)\",\n        \"poverenje\": \"visoko (izmereno, iskop)\",\n        \"veza_3d\": \"druga fizicka tacka olovnog vodovoda posle fontane-nimfej (v0.6, kadrovi VI-VII) — trasa unutar vile dobija dva zemljista tacaka\"\n      },\n      {\n        \"id\": \"kada-e-12\",\n        \"tip\": \"krajnji-cvor\",\n        \"opis\": \"\\\"kada\\\" 1,6 x 1,5 m izmedju zidova 17, 19 i 59, obloga kreznak malterom; autori pitaju \\\"za kupanje? kada?\\\"; pripada medijanskom horizontu 3 (posle 380); presecena bunarom\",\n        \"izvor\": \"Starinar 64/2014, 5.2.1\",\n        \"poverenje\": \"visoko (dimenzije), srednje (funkcija)\"\n      },\n      {\n        \"id\": \"bunar-e-12\",\n        \"tip\": \"kasnosrednjovekovni-ukop\",\n        \"opis\": \"bunar presecen sa \\\"kada\\\": gornja ivica 198.2, dno 196.05 (od v0.13 druga najniza — najniza je 195.96, bunara jama 5 u sonda 105, vidi sobe_sloj.json), dubina ~2,15 m, precnik 1,35 m, kvadratna drvena konstrukcija na dnu; kasnosrednjovekovna zelenglasana keramika\",\n        \"izvor\": \"Starinar 64/2014, 5.2.1\",\n        \"poverenje\": \"visoko\",\n        \"napomena_3d\": \"NE ulazi u 3D antickog kompleksa — dokaz nastavka zivota na rusevinama\"\n      },\n      {\n        \"id\": \"fontana-stibadium-A\",\n        \"tip\": \"fontana\",\n        \"opis\": \"mermerna fontana na postolju ukrasenom morskim crvom, u sredini sestoougaone centralne sale stibadijuma A (podni mozaik 10); druga fontana u kompleksu pored nimfeja i sobe 2 vile sa oktogonom\",\n        \"poverenje\": \"visoko (postojanje); polozaj unutar sale visoko; prikljucak na vodovod nepoznat\",\n        \"status\": \"objekat unisten 1936 — rekonstrukcija samo iz literature i crteza Bratanica iz 1936\",\n        \"izvor\": \"monografija-vila-2011\"\n      }\n    ],\n    \"pravila_konzistentnosti_3d\": [\n      \"svaki vodeni cvor mora imati visinu iznad sledeceg cvora nizvodno (gravitacija bez sifona)\",\n      \"fontana-nimfej i svi bazeni u vili moraju biti ispod nivoa castellum-a (~206 m)\",\n      \"dva kanala se modeluju kao odvojene linije, ne grananje jednog kanala\"\n    ]\n  },\n  \"otvorena_pitanja\": [\n    \"izvor vode: Oblik vs Niska Banja — nijedan primarni izvor jos ne resava; Pop-Lazic 2018 ne navodi\",\n    \"tacna trasa kanala (georeferencirani iskopni plan nedostupan)\",\n    \"'trideset godina vladavine' — Vicennalia (325/6) vs Tricennalia (335/6) — protivurecje u okviru samog teksta (engleski deo teksta proveriti)\",\n    \"Starinar 39 (1988) Jeremic 'Castellum aquae anticke Medijane' postoji u arhivi viminacium.org.rs ali je sken BEZ tekstualnog sloja (206 strana) — ceka OCR; svemirski alat za OCR ne postoji\"\n  ]\n}\n","numLines":184,"startLine":1,"totalLines":184}}}

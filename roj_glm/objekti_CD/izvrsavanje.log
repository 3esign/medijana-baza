{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_ad28b3c78e03465287c9c4b0","type":"tool_result","content":"20575\t<dc:publisher>Bonn : Rei cretariae Romanae favtores</dc:publisher>\n20576\t<dc:source>Rei cretatiae romanae favtorvm acta</dc:source>\n20577\t</oai_dc:dc></metadata></record><record><header><identifier>oai:rai.ai.ac.rs:123456789/634</identifier><datestamp>2024-07-04T09:13:52Z</datestamp><setSpec>com_123456789_1</setSpec><setSpec>col_123456789_3</setSpec></header><metadata><oai_dc:dc xmlns:oai_dc=\"http://www.openarchives.org/OAI/2.0/oai_dc/\" xmlns:doc=\"http://www.lyncode.com/xoai\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xmlns:dc=\"http://purl.org/dc/elements/1.1/\" xsi:schemaLocation=\"http://www.openarchives.org/OAI/2.0/oai_dc/ http://www.openarchives.org/OAI/2.0/oai_dc.xsd\">\n20578\t<dc:title>Itinerarum Romanum Serbiae - Putevima rimskih imperatora po Srbiji : kulturno nasleđe u službi turizma i održivog razvoja</dc:title>\n20579\t<dc:creator>Mrdjić, Nemanja</dc:creator>\n20580\t<dc:creator>Raičković, Angelina</dc:creator>\n20581\t<dc:creator>Redžić, Saša</dc:creator>\n20582\t<dc:subject>Rimski carevi</dc:subject>\n20583\t<dc:subject>Srbija</dc:subject>\n20584\t<dc:subject>Viminacium</dc:subject>\n20585\t<dc:subject>Sirmium</dc:subject>\n20586\t<dc:subject>kulturna ruta</dc:subject>\n20587\t<dc:subject>tematske rute</dc:subject>\n20588\t<dc:description>Teritorija današnje Srbije je rodno mesto 18 rimskih imperatora među kojima se nalaze Konstantin I Veliki i Justinijan I. Ovaj broj čini Srbiju prvom Evropskom zemljom, izuzev Italije, iz koje carevi vode poreklo. Na našoj teritoriji nalaze se carski grad (Sirmium) provincijske prestonice (Sirmium, Viminacium i Iustiniana Prima), kao i carske vile i rezidencije (Felix Romuliana, Šarkamen, Mediana).</dc:description>\n20589\t<dc:date>2023-10-05T06:50:22Z</dc:date>\n20590\t<dc:date>2023-10-05T06:50:22Z</dc:date>\n20591\t<dc:date>2010</dc:date>\n20592\t<dc:type>bookPart</dc:type>\n20593\t<dc:type>publishedVersion</dc:type>\n20594\t<dc:identifier>978-86-7067-140-9</dc:identifier>\n20595\t<dc:identifier>https://rai.ai.ac.rs/handle/123456789/634</dc:identifier>\n20596\t<dc:identifier>http://rai.ai.ac.rs/bitstream/id/2064/bitstream_2064.pdf</dc:identifier>\n20597\t<dc:identifier>https://hdl.handle.net/21.15107/rcub_rai_634</dc:identifier>\n20598\t<dc:language>sr</dc:language>\n20599\t<dc:rights>openAccess</dc:rights>\n20600\t<dc:rights>ARR</dc:rights>\n20601\t<dc:publisher>Beograd : Institut za medjunarodnu politiku i privredu</dc:publisher>\n20602\t<dc:source>Unapredjenje turizma kao faktor razvoja privrede republike Srbije : tematski zbornik radova</dc:source>"}]},"parent_tool_use_id":null,"session_id":"715a8e85-940b-40be-aca9-e0e9c9f6c39d","uuid":"5c2435e0-9142-439e-a382-70c3d65d7353","timestamp":"2026-10-25T22:07:40.413Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Svemir\\data\\sessions\\c1792946760393lb6a\\medijana_baza\\roj_glm\\objekti_CD\\oai_full.xml","content":"<dc:publisher>Bonn : Rei cretariae Romanae favtores</dc:publisher>\n<dc:source>Rei cretatiae romanae favtorvm acta</dc:source>\n</oai_dc:dc></metadata></record><record><header><identifier>oai:rai.ai.ac.rs:123456789/634</identifier><datestamp>2024-07-04T09:13:52Z</datestamp><setSpec>com_123456789_1</setSpec><setSpec>col_123456789_3</setSpec></header><metadata><oai_dc:dc xmlns:oai_dc=\"http://www.openarchives.org/OAI/2.0/oai_dc/\" xmlns:doc=\"http://www.lyncode.com/xoai\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xmlns:dc=\"http://purl.org/dc/elements/1.1/\" xsi:schemaLocation=\"http://www.openarchives.org/OAI/2.0/oai_dc/ http://www.openarchives.org/OAI/2.0/oai_dc.xsd\">\n<dc:title>Itinerarum Romanum Serbiae - Putevima rimskih imperatora po Srbiji : kulturno nasleđe u službi turizma i održivog razvoja</dc:title>\n<dc:creator>Mrdjić, Nemanja</dc:creator>\n<dc:creator>Raičković, Angelina</dc:creator>\n<dc:creator>Redžić, Saša</dc:creator>\n<dc:subject>Rimski carevi</dc:subject>\n<dc:subject>Srbija</dc:subject>\n<dc:subject>Viminacium</dc:subject>\n<dc:subject>Sirmium</dc:subject>\n<dc:subject>kulturna ruta</dc:subject>\n<dc:subject>tematske rute</dc:subject>\n<dc:description>Teritorija današnje Srbije je rodno mesto 18 rimskih imperatora među kojima se nalaze Konstantin I Veliki i Justinijan I. Ovaj broj čini Srbiju prvom Evropskom zemljom, izuzev Italije, iz koje carevi vode poreklo. Na našoj teritoriji nalaze se carski grad (Sirmium) provincijske prestonice (Sirmium, Viminacium i Iustiniana Prima), kao i carske vile i rezidencije (Felix Romuliana, Šarkamen, Mediana).</dc:description>\n<dc:date>2023-10-05T06:50:22Z</dc:date>\n<dc:date>2023-10-05T06:50:22Z</dc:date>\n<dc:date>2010</dc:date>\n<dc:type>bookPart</dc:type>\n<dc:type>publishedVersion</dc:type>\n<dc:identifier>978-86-7067-140-9</dc:identifier>\n<dc:identifier>https://rai.ai.ac.rs/handle/123456789/634</dc:identifier>\n<dc:identifier>http://rai.ai.ac.rs/bitstream/id/2064/bitstream_2064.pdf</dc:identifier>\n<dc:identifier>https://hdl.handle.net/21.15107/rcub_rai_634</dc:identifier>\n<dc:language>sr</dc:language>\n<dc:rights>openAccess</dc:rights>\n<dc:rights>ARR</dc:rights>\n<dc:publisher>Beograd : Institut za medjunarodnu politiku i privredu</dc:publisher>\n<dc:source>Unapredjenje turizma kao faktor razvoja privrede republike Srbije : tematski zbornik radova</dc:source>","numLines":28,"startLine":20575,"totalLines":71039}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_44a4e75546f14a3ab7635013","type":"tool_result","content":"29620\t<dc:identifier>https://hdl.handle.net/21.15107/rcub_rai_983</dc:identifier>\n29621\t<dc:language>sr</dc:language>\n29622\t<dc:relation>info:eu-repo/grantAgreement/MESTD/Basic Research (BR or ON)/177007/RS//</dc:relation>\n29623\t<dc:rights>openAccess</dc:rights>\n29624\t<dc:rights>https://creativecommons.org/licenses/by/4.0/</dc:rights>\n29625\t<dc:rights>BY</dc:rights>\n29626\t<dc:publisher>Ниш : Завод за заштиту споменика културе</dc:publisher>\n29627\t<dc:source>Стубови баштине</dc:source>\n29628\t</oai_dc:dc></metadata></record><record><header><identifier>oai:rai.ai.ac.rs:123456789/984</identifier><datestamp>2025-01-09T11:34:39Z</datestamp><setSpec>com_123456789_1</setSpec><setSpec>col_123456789_3</setSpec></header><metadata><oai_dc:dc xmlns:oai_dc=\"http://www.openarchives.org/OAI/2.0/oai_dc/\" xmlns:doc=\"http://www.lyncode.com/xoai\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xmlns:dc=\"http://purl.org/dc/elements/1.1/\" xsi:schemaLocation=\"http://www.openarchives.org/OAI/2.0/oai_dc/ http://www.openarchives.org/OAI/2.0/oai_dc.xsd\">\n29629\t<dc:title>Стаклена перла са представом жабе из Медијане</dc:title>\n29630\t<dc:creator>Jeremić, Gordana</dc:creator>\n29631\t<dc:subject>стаклена перла / жаба / натпис / амулет / импорт / Медијана  (Mediana) / касна антика / IV век</dc:subject>\n29632\t<dc:description>Током археолошких истраживања 2007. године, на простору цркве бр. 2 у касноантичком насељу Медијана (Mediana, Брзи Брод), у предграђу Наиса (Naissus, Ниш), регистрована је перла од црног стакла, са фигуралном представом и натписом. Реч је о спљоштеној овалној перли са вертикалним каналом на средишњем делу. На горњој страни, у кружном пољу, приказана је жаба гледана одозго. Представљена је реалистично, занатски вешто приказане анатомије, са натписом на грчком језику ZO-[Η]N. Реч је о јединственом налазу са приказом жабе у стаклу црне боје. У раду ћемо се бавити овом занимљивом представом, и то са аспекта симболике, функције и декоративности. Представе жаба су израђиване на другим материјалима (печена глина, бронза) и предметима (употребни, религијски, магијски итд.), &#xd;\n29633\tа писани извори пружају драгоцене податке о односу античког живља према овој врсти водоземаца. Налази сличних стаклених перли и привезака, од плавичастог, жућкастог или браонкастог стакла, регистровани су углавном у гробним целинама на територији Паноније у IV  веку или у оквирима музејских збирки, без познатог места налаза. Ови предмети, као и примерак из Медијане, највероватније представљају импорт из источних радионица, чији &#xd;\n29634\tсу производи стигли до ових простора трговачким или другим каналима.</dc:description>\n29635\t<dc:date>2023-11-23T12:39:04Z</dc:date>\n29636\t<dc:date>2023-11-23T12:39:04Z</dc:date>\n29637\t<dc:date>2015</dc:date>\n29638\t<dc:type>article</dc:type>\n29639\t<dc:type>publishedVersion</dc:type>\n29640\t<dc:identifier>0352-2474</dc:identifier>\n29641\t<dc:identifier>https://rai.ai.ac.rs/handle/123456789/984</dc:identifier>\n29642\t<dc:identifier>http://rai.ai.ac.rs/bitstream/id/2220/bitstream_2220.pdf</dc:identifier>\n29643\t<dc:identifier>https://hdl.handle.net/21.15107/rcub_rai_984</dc:identifier>\n29644\t<dc:language>sr</dc:language>\n29645\t<dc:relation>info:eu-repo/grantAgreement/MESTD/Basic Research (BR or ON)/177007/RS//</dc:relation>\n29646\t<dc:rights>openAccess</dc:rights>\n29647\t<dc:rights>ARR</dc:rights>\n29648\t<dc:publisher>Београд : Народни музеј</dc:publisher>\n29649\t<dc:source>Зборник Народног музеја - археологија XXII-1, Београдe 2015, 217-232</dc:source>"}]},"parent_tool_use_id":null,"session_id":"715a8e85-940b-40be-aca9-e0e9c9f6c39d","uuid":"79e8a884-dcb2-4fa2-992d-1cfcdf2a9476","timestamp":"2026-10-25T22:07:40.415Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Svemir\\data\\sessions\\c1792946760393lb6a\\medijana_baza\\roj_glm\\objekti_CD\\oai_full.xml","content":"<dc:identifier>https://hdl.handle.net/21.15107/rcub_rai_983</dc:identifier>\n<dc:language>sr</dc:language>\n<dc:relation>info:eu-repo/grantAgreement/MESTD/Basic Research (BR or ON)/177007/RS//</dc:relation>\n<dc:rights>openAccess</dc:rights>\n<dc:rights>https://creativecommons.org/licenses/by/4.0/</dc:rights>\n<dc:rights>BY</dc:rights>\n<dc:publisher>Ниш : Завод за заштиту споменика културе</dc:publisher>\n<dc:source>Стубови баштине</dc:source>\n</oai_dc:dc></metadata></record><record><header><identifier>oai:rai.ai.ac.rs:123456789/984</identifier><datestamp>2025-01-09T11:34:39Z</datestamp><setSpec>com_123456789_1</setSpec><setSpec>col_123456789_3</setSpec></header><metadata><oai_dc:dc xmlns:oai_dc=\"http://www.openarchives.org/OAI/2.0/oai_dc/\" xmlns:doc=\"http://www.lyncode.com/xoai\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xmlns:dc=\"http://purl.org/dc/elements/1.1/\" xsi:schemaLocation=\"http://www.openarchives.org/OAI/2.0/oai_dc/ http://www.openarchives.org/OAI/2.0/oai_dc.xsd\">\n<dc:title>Стаклена перла са представом жабе из Медијане</dc:title>\n<dc:creator>Jeremić, Gordana</dc:creator>\n<dc:subject>стаклена перла / жаба / натпис / амулет / импорт / Медијана  (Mediana) / касна антика / IV век</dc:subject>\n<dc:description>Током археолошких истраживања 2007. године, на простору цркве бр. 2 у касноантичком насељу Медијана (Mediana, Брзи Брод), у предграђу Наиса (Naissus, Ниш), регистрована је перла од црног стакла, са фигуралном представом и натписом. Реч је о спљоштеној овалној перли са вертикалним каналом на средишњем делу. На горњој страни, у кружном пољу, приказана је жаба гледана одозго. Представљена је реалистично, занатски вешто приказане анатомије, са натписом на грчком језику ZO-[Η]N. Реч је о јединственом налазу са приказом жабе у стаклу црне боје. У раду ћемо се бавити овом занимљивом представом, и то са аспекта симболике, функције и декоративности. Представе жаба су израђиване на другим материјалима (печена глина, бронза) и предметима (употребни, религијски, магијски итд.), &#xd;\nа писани извори пружају драгоцене податке о односу античког живља према овој врсти водоземаца. Налази сличних стаклених перли и привезака, од плавичастог, жућкастог или браонкастог стакла, регистровани су углавном у гробним целинама на територији Паноније у IV  веку или у оквирима музејских збирки, без познатог места налаза. Ови предмети, као и примерак из Медијане, највероватније представљају импорт из источних радионица, чији &#xd;\nсу производи стигли до ових простора трговачким или другим каналима.</dc:description>\n<dc:date>2023-11-23T12:39:04Z</dc:date>\n<dc:date>2023-11-23T12:39:04Z</dc:date>\n<dc:date>2015</dc:date>\n<dc:type>article</dc:type>\n<dc:type>publishedVersion</dc:type>\n<dc:identifier>0352-2474</dc:identifier>\n<dc:identifier>https://rai.ai.ac.rs/handle/123456789/984</dc:identifier>\n<dc:identifier>http://rai.ai.ac.rs/bitstream/id/2220/bitstream_2220.pdf</dc:identifier>\n<dc:identifier>https://hdl.handle.net/21.15107/rcub_rai_984</dc:identifier>\n<dc:language>sr</dc:language>\n<dc:relation>info:eu-repo/grantAgreement/MESTD/Basic Research (BR or ON)/177007/RS//</dc:relation>\n<dc:rights>openAccess</dc:rights>\n<dc:rights>ARR</dc:rights>\n<dc:publisher>Београд : Народни музеј</dc:publisher>\n<dc:source>Зборник Народног музеја - археологија XXII-1, Београдe 2015, 217-232</dc:source>","numLines":30,"startLine":29620,"totalLines":71039}}}

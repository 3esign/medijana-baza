>\n72:<meta content=\"Illyricum Romanum : Studiola in honorem Miloje Vasić\" name=\"citation_title\">\n73:<meta content=\"Institute of Archaeology\" name=\"citation_publisher\">\n74:<meta content=\"en\" name=\"citation_language\">\n75:<meta content=\"2020\" name=\"citation_date\">\n76:<meta content=\"https://rai.ai.ac.rs/handle/123456789/1184\" name=\"citation_abstract_html_url\">\n77-<script async=\"true\" src=\"https://www.googletagmanager.com/gtag/js?id=G-FZP0B59C4P\"></script><script>\n78-\t\twindow.dataLayer = window.dataLayer || [];\n79-\t\tfunction gtag(){dataLayer.push(arguments);}"}]},"parent_tool_use_id":"call_58909c1e0d5f4aed9a483050","session_id":"715a8e85-940b-40be-aca9-e0e9c9f6c39d","uuid":"f3754de6-8a24-4980-a45c-3421c0a5756e","timestamp":"2026-10-25T22:06:30.237Z","subagent_type":"general-purpose","task_description":"Lov na Milošević Urbanism Mediana"}
